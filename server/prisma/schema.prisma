generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id              String             @id @default(uuid())
  name            String
  email           String             @unique
  password        String
  targetRole      String?
  experienceLevel String?
  skills          String?            // SQLite doesn't support String[] natively, storing as comma-separated or JSON
  sessions        InterviewSession[]
  createdAt       DateTime           @default(now())
}

model InterviewSession {
  id           String             @id @default(uuid())
  type         String
  status       String             @default("PENDING")
  startedAt    DateTime           @default(now())
  overallScore Float?
  resumeText   String?            // New field for AI context
  user         User               @relation(fields: [userId], references: [id])
  userId       String
  exchanges    QuestionExchange[]
}

model QuestionExchange {
  id             String           @id @default(uuid())
  sequenceIndex  Int
  questionText   String
  userAnswerText String?
  answerQuality  String?
  feedback       String?          // JSON string for score, critique, improvementTip
  session        InterviewSession @relation(fields: [sessionId], references: [id])
  sessionId      String
}
