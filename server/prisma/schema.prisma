datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id                  String             @id @default(uuid())
  name                String
  email               String             @unique
  password            String
  targetRole          String             @default("Software Engineer")
  experienceLevel     String             @default("Junior")
  skills              String?             // SQLite doesn't support arrays, use JSON string
  resumeClaims        String?             // SQLite doesn't support arrays, use JSON string
  interviewsCompleted Int                @default(0)
  avgScore            Float              @default(0)
  resumeText          String?
  createdAt           DateTime           @default(now())
  sessions            InterviewSession[]
}

model InterviewSession {
  id                String             @id @default(uuid())
  userId            String
  user              User               @relation(fields: [userId], references: [id])
  type              String             @default("HR")
  status            String             @default("ACTIVE")
  startedAt         DateTime           @default(now())
  endedAt           DateTime?
  overallScore      Int                @default(0)
  transcriptSummary String?
  exchanges         QuestionExchange[]
}

model QuestionExchange {
  id                    String           @id @default(uuid())
  sessionId             String
  session               InterviewSession @relation(fields: [sessionId], references: [id])
  sequenceIndex         Int
  questionText          String
  topic                 String?
  complexity            String           @default("Medium")
  answerQuality         String           @default("N/A")
  userAnswerText        String?
  responseTimeMs        Int?
  feedbackScore         Int?
  feedbackCritique      String?
  feedbackImprovementTip String?
  feedbackToneAnalysis  String?
  createdAt             DateTime         @default(now())
}
